# OpenAI API Configuration (Priority 1)
# Enter your OpenAI API key below to enable GPT-4o-mini generation
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default OpenAI model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# =============================================================
# Ollama — Optional Free Local AI Provider (Priority 2)
# =============================================================
# Ollama runs locally — no API key or subscription needed!
# Install from: https://ollama.com/download
# Then pull a model: ollama pull llama3.1
#
# Priority chain: OpenAI > Ollama > Structured Demo fallback
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
#
# Supported models:
#   llama3.1  — Best JSON quality, ~5GB RAM (recommended)
#   mistral   — Fast, ~4GB RAM
#   phi3      — Lightweight, ~2.5GB RAM
#   gemma2    — Excellent quality, ~6GB RAM
#   llama3.2  — Smallest & fastest, ~2GB RAM
